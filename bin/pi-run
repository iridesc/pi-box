#!/bin/bash
# pi-run — Agent 任务快捷方式：非交互跑一次 pi（cron 任务统一命令模型下的便捷包装）
# 用法：pi-run "自然语言任务描述"
# 与 pi-job 共用全局凭据（/home/agent/.pi/agent），session 隔离在 /workspace/.cron/sessions
set -euo pipefail

export HOME=/home/agent
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
export TZ="${TZ:-Asia/Shanghai}"

# 回填容器注入的环境变量（compose environment / env_file）：cron 不继承容器环境，
# 见 entrypoint.sh 的导出逻辑；/workspace/.cron/env 为用户自定义变量（可选，优先级更高）。
if [ -r /run/pi-box/job-env.sh ]; then . /run/pi-box/job-env.sh; fi
if [ -r /workspace/.cron/env ]; then . /workspace/.cron/env; fi

exec pi -p -a --session-dir /workspace/.cron/sessions "$@"
